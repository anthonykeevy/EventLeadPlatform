# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
# Excluding these improves code review: model focuses on your code, not libraries or generated files.

# --- Dependencies / third-party (large, not for review) ---
frontend/node_modules/
node_modules/
backend/venv/
backend/.venv/
backend/env/
.venv/
venv/
env/
ENV/

# --- Lock files (huge, low value for review) ---
package-lock.json
frontend/package-lock.json
*.lock

# --- Python generated / cache ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/
build/
dist/
*.so

# --- Frontend build output ---
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# --- Test / coverage output ---
.pytest_cache/
.coverage
htmlcov/
coverage/
*.lcov

# --- Logs and temp ---
*.log
logs/
*.tmp
*.temp
*.pid

# --- BMAD framework (optional: remove this block if you want BMAD in review context) ---
# --- bmad/ ---

# --- Cursor/IDE (optional: keeps review focused on project code) ---
# --- .cursor/rules/ ---

# --- Docs build artifacts ---
docs/_build/
docs/build/

# --- Environment / secrets (never index) ---
.env
.env.*
!.env.example

# --- OS / IDE ---
.DS_Store
.idea/
.vscode/