    <BusinessContext>
        <Problem>
            Form owners need to grant access to forms for users and companies with different permission levels (View, Edit, Manage, Submit, Analyze). Currently, forms are only accessible to company owners. Need granular access control with expiry support and audit trails.
        </Problem>
        
        <Solution>
            Implement FormAccessControl management system with CRUD operations, access grants/revocations, access expiry support, query guards for access checks, and UI for managing form access. Integrate access checks into form operations and display access indicators in form list/detail views.
        </Solution>
        
        <BusinessValue>
            - Enable form sharing across companies and users
            - Support different permission levels for collaboration
            - Provide temporary access with expiry support
            - Maintain audit trail for access grants/revocations
            - Foundation for form collaboration features
        </BusinessValue>
    </BusinessContext>
    
    <TechnicalContext>
        <Architecture>
            <Backend>
                <Model>FormAccessControl SQLAlchemy model</Model>
                <Service>FormAccessControlService with grant/revoke/check methods</Service>
                <Router>Access control API endpoints (POST, GET, DELETE)</Router>
                <Schema>Pydantic schemas for access control requests/responses</Schema>
                <Guard>Access check query guards integrated into form service</Guard>
            </Backend>
            
            <Frontend>
                <Component>FormAccessControlModal for access management</Component>
                <Component>GrantAccessForm for granting access</Component>
                <API>formAccessApi.ts for access control API integration</API>
                <Integration>Access control integrated into FormDetailView</Integration>
                <Integration>Access indicators in FormList</Integration>
            </Frontend>
            
            <Database>
                <Table>FormAccessControl with access grant details</Table>
                <Reference>FormAccessControlAccessType (View, Edit, Manage, Submit, Analyze)</Reference>
                <Reference>CompanyRelationshipType (Partner, Vendor, Client, Affiliate)</Reference>
                <Function>dbo.CheckFormAccess for access checks</Function>
                <Constraint>Unique constraint on (FormID, UserID, CompanyID)</Constraint>
            </Database>
        </Architecture>
        
        <KeyPatterns>
            <Pattern>Access Control Query Guards - Filter forms based on user access</Pattern>
            <Pattern>Access Grant/Revoke Operations - CRUD operations for access control</Pattern>
            <Pattern>Access Expiry Validation - Exclude expired access from access checks</Pattern>
            <Pattern>Duplicate Access Prevention - Unique constraint prevents duplicate grants</Pattern>
            <Pattern>Access-Based UI Permissions - Show/hide UI elements based on access level</Pattern>
        </KeyPatterns>
        
        <IntegrationPoints>
