# Optional: explicit API hostname when the SPA and backend are NOT same-origin.
# Leave unset so the UI calls "/api/..." on the current host (recommended for Azure
# where FastAPI serves the built SPA).
#
# VITE_API_BASE_URL=https://api.your-domain.example
#
# Local: Vite proxies /api to http://127.0.0.1:8000 (see vite.config.ts). You rarely
# need this for local unless you bypass the proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8000
