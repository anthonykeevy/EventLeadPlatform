# API Base URL - override for different environments
# Default: localhost:8000 (dev) or https://api.signalplatforms.io (when host is signalplatforms.io)
#
# Local development:
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Production (api.signalplatforms.io):
# VITE_API_BASE_URL=https://api.signalplatforms.io
#
# Copy to .env.development or .env.production as needed.
